<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

	<bean id="camelTracer" class="org.apache.camel.processor.interceptor.Tracer">
		  <property name="traceOutExchanges" value="true" />
		  <property name="logStackTrace" value="true" />
	</bean>

	<bean id="traceFormatter" class="org.apache.camel.processor.interceptor.DefaultTraceFormatter">
		<property name="showBreadCrumb" value="true" />
		<property name="showNode" value="true" />
		<property name="showExchangeId" value="true" />
		<property name="showShortExchangeId" value="true" />
		<property name="showProperties" value="true" />
		<property name="showHeaders" value="true" />
		<property name="showBodyType" value="true" />
		<property name="showBody" value="true" />
		<property name="showOutHeaders" value="true" />
		<property name="showOutBodyType" value="true" />
		<property name="showOutBody" value="true" />
		<property name="showExchangePattern" value="true" />
		<property name="showException" value="true" />
		<property name="showRouteId" value="true" />
		<property name="maxChars" value="1000000" />
	</bean>

	<camelContext trace ="false" xmlns="http://camel.apache.org/schema/spring">
		<errorHandler id="NoErrorHandler" type="NoErrorHandler"/>
		<restConfiguration component="netty4-http" port="9090" apiContextPath = "/api-docs" enableCORS = "true" clientRequestValidation = "false">
			<endpointProperty key="chunkedMaxContentLength" value="{{server.chunkedMaxContentLength}}"/>
			<apiProperty key = "api.title" value = "RGS Integration Platform API"/>
			<apiProperty key = "api.version" value = "2.0"/>
			<apiProperty key = "api.description" value = "Интеграционное API компании 'Росгосстрах'"/>
			<apiProperty key = "api.contact.name" value = "Сергей Головкин"/>
			<apiProperty key = "api.contact.email" value = "rgsip@rgs.ru"/>
        </restConfiguration>
	</camelContext>
</beans>
