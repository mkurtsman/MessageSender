<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns="http://camel.apache.org/schema/spring">
	<route id="sendRoute" autoStartup="true">
		<from uri="timer://sendTimer?fixedRate=true&amp;period={{timer.period}}"/>
		<onException>
			<exception>java.lang.Exception</exception>
			<log loggingLevel="ERROR" message="${exception.getMessage()} ${exception}" />
		</onException>

		<log loggingLevel="INFO" message="invoke timer" />
		<setHeader name="testHeader">
			<method ref="uuidGenerator" method="getUuid"/>
		</setHeader>
		<setBody>
			<constant>file:C:/Users/MKurtsman/work/messagesender/src/main/resources?filename=body.xml</constant>
		</setBody>

		<setProperty name="counter">
			<simple resultType="Long">0</simple>
		</setProperty>
		<loop doWhile="true">
			<simple>${exchangeProperty.counter} &lt; {{maxcount}}</simple>
			<setHeader name="CorrelationId">
				<method ref="uuidGenerator" method="getUuid"/>
			</setHeader>
			<log loggingLevel="INFO" message="send message ${header.CorrelationId} number ${exchangeProperty.counter}" />
			<to uri="rabbitmq:{{queue.exchange}}?addresses={{rabbitmq.hosts}}&amp;queue={{queue.name}}&amp;routingKey={{queue.routingKey}}&amp;username={{rabbitmq.username}}&amp;password={{rabbitmq.password}}&amp;exchangePattern=InOnly&amp;declare=false&amp;guaranteedDeliveries=true&amp;automaticRecoveryEnabled=true"/>
			<setProperty name="counter">
				<method ref="math" method="increment(${exchangeProperty.counter})"/>
			</setProperty>
		</loop>
	    <stop/>
	</route>
</routes>
